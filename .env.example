# ================================================================
# Biến môi trường mẫu. Chép thành .env rồi điền giá trị thật:
#   cp .env.example .env
# KHÔNG đặt NODE_ENV ở đây: `next build` sẽ lỗi nếu NODE_ENV=development.
# ================================================================

# ----- Database (PostgreSQL trong Docker, cổng 5433) -----
DATABASE_URL="postgresql://ktm:ktm_dev_password@127.0.0.1:5433/khoathongminh?schema=public"

# ----- Redis (trong Docker, cổng 6380) -----
REDIS_URL="redis://127.0.0.1:6380"

# ----- API -----
API_PORT=4000
# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Production: .khoathongminhchinhhang.vn  |  Máy dev: để trống
COOKIE_DOMAIN=

# ----- JWT: 2 secret KHÁC NHAU, mỗi cái tối thiểu 32 ký tự -----
# Tạo bằng lệnh: openssl rand -base64 48
JWT_STAFF_ACCESS_SECRET=
JWT_STAFF_REFRESH_SECRET=

# ----- Frontend (được nhúng vào code khi build) -----
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ----- Worker -----
# Số job xử lý song song
WORKER_CONCURRENCY=5