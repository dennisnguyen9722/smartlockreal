// Prisma ORM 7. Quy ước đặt tên:
// - Trong code: PascalCase (model), camelCase (field)
// - Trong PostgreSQL: snake_case, dùng @@map và @map

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Giá trị enum phải khớp với LocationType và Region trong @ktm/shared
enum LocationType {
  WAREHOUSE
  STORE

  @@map("location_type")
}

enum Region {
  HCM
  HN

  @@map("region")
}

/// Showroom (type STORE) và kho di sản (WAREHOUSE, không dùng: công ty không giữ kho).
/// Showroom dùng cho trang showroom trên website (SEO địa phương) và đơn "nhận tại showroom".
model Location {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique @db.VarChar(32)
  name      String       @db.VarChar(255)
  type      LocationType
  region    Region
  address   String
  phone     String?      @db.VarChar(20)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  // ----- Showroom (Bước 8). CHECK viết tay trong migration *_showrooms -----
  /// Đường dẫn trang showroom: showroomPath() trong @ktm/shared
  slug          String?   @unique @db.VarChar(120)
  /// Địa chỉ chuẩn 2 cấp; cột address = "street, ward_name, province_name" do API dựng
  provinceCode  String?   @map("province_code") @db.VarChar(10)
  provinceName  String?   @map("province_name") @db.VarChar(100)
  wardCode      String?   @map("ward_code") @db.VarChar(10)
  wardName      String?   @map("ward_name") @db.VarChar(100)
  street        String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?   @map("google_maps_url")
  /// [{ "day": 1, "opens": "08:00", "closes": "21:00" }]; day 1 = Thứ Hai ... 7 = Chủ nhật; ngày không có = nghỉ
  openingHours  Json      @default("[]") @map("opening_hours")
  description   String?
  email         String?   @db.VarChar(255)
  /// Ảnh đầu tiên là ảnh đại diện. Lưu theo url như product_media: xóa ảnh thư viện phải kiểm tra cột này
  imageUrls     String[]  @default([]) @map("image_urls")
  /// Hiện trên website
  isPublic      Boolean   @default(false) @map("is_public")
  /// Lần đầu đăng lên website; từ đó đổi slug sẽ tạo redirect 301
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  sortOrder     Int       @default(0) @map("sort_order")

  stockLevels   StockLevel[]
  serialUnits   SerialUnit[]
  goodsReceipts GoodsReceipt[]
  transfersOut  StockTransfer[] @relation("TransferFrom")
  transfersIn   StockTransfer[] @relation("TransferTo")
  stocktakes    Stocktake[]

  fulfillmentOrders Order[]

  shipmentsOut Shipment[]

  technicians            Technician[]
  receivedWarrantyClaims WarrantyClaim[]
  vendorReturns          VendorReturn[]

  @@map("locations")
}

// ============================================================
// NHÓM 3.1: DANH MỤC SẢN PHẨM
// Tiền: BigInt (VND). Sản phẩm không bị xóa, chỉ chuyển ARCHIVED.
// Ràng buộc CHECK viết tay nằm trong migration *_catalog (slug, SKU, giá, combo...).
// Prisma không quản lý CHECK: khi thêm ràng buộc mới, tạo migration --create-only rồi viết SQL.
// ============================================================

enum ProductType {
  LOCK
  ACCESSORY
  SERVICE
  BUNDLE

  @@map("product_type")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum SpecDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT

  @@map("spec_data_type")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum ProductRelationType {
  ACCESSORY
  SIMILAR
  UPSELL

  @@map("product_relation_type")
}

/// Hãng khóa
model Brand {
  id                     String    @id @default(uuid(7)) @db.Uuid
  slug                   String    @unique @db.VarChar(120)
  name                   String    @db.VarChar(120)
  logoUrl                String?   @map("logo_url")
  description            String?
  countryOfOrigin        String?   @map("country_of_origin") @db.VarChar(80)
  /// Công ty có giấy ủy quyền phân phối chính hãng
  isAuthorized           Boolean   @default(false) @map("is_authorized")
  authorizationDocUrl    String?   @map("authorization_doc_url")
  authorizationExpiresAt DateTime? @map("authorization_expires_at") @db.Date
  isActive               Boolean   @default(true) @map("is_active")
  sortOrder              Int       @default(0) @map("sort_order")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  voucherTargets VoucherTarget[]

  @@map("brands")
}

/// Danh mục dạng cây
model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  specDefinitions SpecDefinition[]
  /// Banner "đầu trang danh mục" riêng của danh mục này
  banners         Banner[]

  voucherTargets VoucherTarget[]

  @@index([parentId])
  @@map("categories")
}

/// Khuôn thông số kỹ thuật theo danh mục: kiểm tra dữ liệu và sinh bộ lọc
model SpecDefinition {
  id           String       @id @default(uuid(7)) @db.Uuid
  categoryId   String       @map("category_id") @db.Uuid
  /// Khóa trong products.specs, vd: unlock_methods
  code         String       @db.VarChar(64)
  name         String       @db.VarChar(120)
  /// Nhóm hiển thị trong bảng thông số, vd: Vận hành, Kích thước cửa
  groupName    String?      @map("group_name") @db.VarChar(80)
  dataType     SpecDataType @map("data_type")
  unit         String?      @db.VarChar(20)
  /// Giá trị cho SELECT/MULTI_SELECT: [{ "value": "fingerprint", "label": "Vân tay" }]
  options      Json?
  isFilterable Boolean      @default(false) @map("is_filterable")
  isRequired   Boolean      @default(false) @map("is_required")
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, code])
  @@map("spec_definitions")
}

/// Nhóm tính giá lắp đặt theo loại khóa/cửa
model InstallationClass {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rates    InstallationRate[]
  products Product[]

  orderLines OrderLine[]

  quoteLines QuoteLine[]

  @@map("installation_classes")
}

/// Giá lắp đặt theo (nhóm lắp đặt, khu vực)
model InstallationRate {
  installationClassId String   @map("installation_class_id") @db.Uuid
  region              Region
  price               BigInt
  isActive            Boolean  @default(true) @map("is_active")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  installationClass InstallationClass @relation(fields: [installationClassId], references: [id], onDelete: Cascade)

  @@id([installationClassId, region])
  @@map("installation_rates")
}

/// Mẫu sản phẩm (khóa, phụ kiện, dịch vụ, combo)
model Product {
  id                  String        @id @default(uuid(7)) @db.Uuid
  type                ProductType
  status              ProductStatus @default(DRAFT)
  /// Dịch vụ không có hãng
  brandId             String?       @map("brand_id") @db.Uuid
  categoryId          String        @map("category_id") @db.Uuid
  /// Chỉ khóa mới có; null = không nhận lắp đặt
  installationClassId String?       @map("installation_class_id") @db.Uuid
  slug                String        @unique @db.VarChar(160)
  name                String        @db.VarChar(200)
  /// Mã model của hãng (có thể trùng giữa các hãng)
  manufacturerCode    String?       @map("manufacturer_code") @db.VarChar(80)
  shortDescription    String?       @map("short_description")
  description         String?
  /// Giá trị thông số, khóa theo spec_definitions.code
  specs               Json          @default("{}")
  /// Điểm nổi bật theo nhóm: [{ "title": "Tính năng", "items": ["..."] }]
  highlights          Json          @default("[]")
  warrantyMonths      Int           @default(0) @map("warranty_months")
  seoTitle            String?       @map("seo_title") @db.VarChar(200)
  seoDescription      String?       @map("seo_description") @db.VarChar(320)
  publishedAt         DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installationClass InstallationClass? @relation(fields: [installationClassId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  options           ProductOption[]
  media             ProductMedia[]
  relations         ProductRelation[]  @relation("RelationSource")
  relatedFrom       ProductRelation[]  @relation("RelationTarget")

  voucherTargets VoucherTarget[]

  /// Do trigger tự tính từ đánh giá đã duyệt
  ratingCount Int             @default(0) @map("rating_count")
  ratingSum   Int             @default(0) @map("rating_sum")
  reviews     ProductReview[]
  faqs        Faq[]
  postLinks   PostProduct[]

  @@index([brandId])
  @@index([categoryId])
  @@index([type, status])
  @@index([specs(ops: JsonbPathOps)], type: Gin)
  @@map("products")
}

/// Trục lựa chọn của sản phẩm (Màu, Phiên bản)
model ProductOption {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  code      String @db.VarChar(60)
  name      String @db.VarChar(60)
  sortOrder Int    @default(0) @map("sort_order")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, code])
  @@map("product_options")
}

/// Giá trị của một trục lựa chọn (Đen, Vàng đồng)
model ProductOptionValue {
  id        String @id @default(uuid(7)) @db.Uuid
  optionId  String @map("option_id") @db.Uuid
  code      String @db.VarChar(60)
  value     String @db.VarChar(60)
  sortOrder Int    @default(0) @map("sort_order")

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, code])
  @@map("product_option_values")
}

/// Biến thể: mặt hàng bán được thật (SKU, giá, serial)
model ProductVariant {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  /// SKU nội bộ do công ty đặt, duy nhất toàn hệ thống
  sku            String   @unique @db.VarChar(64)
  name           String   @db.VarChar(200)
  /// Tổ hợp lựa chọn đã sắp xếp, vd: "mau:den|phien-ban:wifi". Rỗng nếu sản phẩm không có lựa chọn.
  optionKey      String   @default("") @map("option_key") @db.VarChar(255)
  /// Giá bán lẻ niêm yết (VND)
  price          BigInt
  /// Giá gạch ngang để hiển thị (VND)
  compareAtPrice BigInt?  @map("compare_at_price")
  barcode        String?  @db.VarChar(64)
  weightGrams    Int?     @map("weight_grams")
  trackSerial    Boolean  @default(false) @map("track_serial")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  optionValues  VariantOptionValue[]
  media         ProductMedia[]
  bundleItems   BundleItem[]         @relation("BundleParent")
  usedInBundles BundleItem[]         @relation("BundleComponent")

  stockLevels    StockLevel[]
  serialUnits    SerialUnit[]
  receiptLines   GoodsReceiptLine[]
  transferLines  StockTransferLine[]
  stocktakeLines StocktakeLine[]

  regionPrices  VariantRegionPrice[]
  groupPrices   GroupVariantPrice[]
  quantityTiers QuantityPriceTier[]
  saleItems     SaleCampaignItem[]
  giftTriggers  GiftTrigger[]
  giftItems     GiftItem[]

  /// Thuế suất VAT theo phần vạn (1000 = 10%)
  vatRateBps Int         @default(1000) @map("vat_rate_bps")
  orderLines OrderLine[]

  quoteLines QuoteLine[]

  @@unique([productId, optionKey])
  @@map("product_variants")
}

/// Biến thể nào ứng với giá trị lựa chọn nào
model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

/// Ảnh và video sản phẩm; variant_id có giá trị nếu ảnh chỉ dành cho một biến thể
model ProductMedia {
  id        String    @id @default(uuid(7)) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  variantId String?   @map("variant_id") @db.Uuid
  type      MediaType @default(IMAGE)
  url       String
  altText   String?   @map("alt_text") @db.VarChar(200)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_media")
}

/// Thành phần của combo
model BundleItem {
  bundleVariantId    String @map("bundle_variant_id") @db.Uuid
  componentVariantId String @map("component_variant_id") @db.Uuid
  quantity           Int    @default(1)

  bundleVariant    ProductVariant @relation("BundleParent", fields: [bundleVariantId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("BundleComponent", fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@id([bundleVariantId, componentVariantId])
  @@index([componentVariantId])
  @@map("bundle_items")
}

/// Sản phẩm liên quan: phụ kiện tương thích, sản phẩm tương tự, gợi ý nâng cấp
model ProductRelation {
  productId        String              @map("product_id") @db.Uuid
  relatedProductId String              @map("related_product_id") @db.Uuid
  type             ProductRelationType
  sortOrder        Int                 @default(0) @map("sort_order")

  product        Product @relation("RelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId, type])
  @@index([relatedProductId])
  @@map("product_relations")
}

// ============================================================
// NHÓM 3.2: TỒN KHO
// on_hand chỉ gồm hàng MỚI bán được; hàng trưng bày và hàng lỗi không tính.
// Mọi thay đổi on_hand phải ghi stock_movements trong CÙNG transaction.
// CHECK và trigger viết tay nằm trong migration *_inventory.
// stock_movements có trigger chặn UPDATE/DELETE/TRUNCATE: sửa sai bằng cách ghi thêm dòng ADJUSTMENT.
// ============================================================

enum SerialUnitStatus {
  IN_STOCK
  DISPLAY
  IN_TRANSIT
  SOLD
  DEFECTIVE
  AT_VENDOR
  SCRAPPED

  @@map("serial_unit_status")
}

enum ReservationSource {
  /// Giữ tạm trong lúc thanh toán online, có hạn
  ONLINE_CHECKOUT
  /// Giữ theo đơn (COD, chuyển khoản, đặt cọc showroom), không hạn
  ORDER

  @@map("reservation_source")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum StockMovementType {
  RECEIPT
  SALE
  SALE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  TO_DISPLAY
  FROM_DISPLAY
  DISPLAY_SALE
  MARK_DEFECTIVE
  SEND_TO_VENDOR
  RECEIVE_FROM_VENDOR
  SCRAP

  @@map("stock_movement_type")
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED

  @@map("document_status")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED

  @@map("transfer_status")
}

/// Tồn kho hàng mới theo (biến thể, showroom). Bán được = on_hand - reserved.
model StockLevel {
  variantId  String   @map("variant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  onHand     Int      @default(0) @map("on_hand")
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant      ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reservations StockReservation[]
  movements    StockMovement[]

  @@id([variantId, locationId])
  @@index([locationId])
  @@map("stock_levels")
}

/// Từng chiếc có serial
model SerialUnit {
  id            String           @id @default(uuid(7)) @db.Uuid
  variantId     String           @map("variant_id") @db.Uuid
  /// Viết hoa, không khoảng trắng đầu/cuối
  serialNumber  String           @map("serial_number") @db.VarChar(100)
  status        SerialUnitStatus @default(IN_STOCK)
  /// Null khi chiếc không nằm ở showroom nào (đã bán, đang chuyển, ở hãng...)
  locationId    String?          @map("location_id") @db.Uuid
  /// Giá bán hàng trưng bày (VND)
  displayPrice  BigInt?          @map("display_price")
  /// Đang rao bán hàng trưng bày trên website
  isListed      Boolean          @default(false) @map("is_listed")
  conditionNote String?          @map("condition_note")
  /// Ảnh thực tế của máy trưng bày: ["url1", "url2"]
  displayPhotos Json             @default("[]") @map("display_photos")
  receivedAt    DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  soldAt        DateTime?        @map("sold_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location  Location?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  shipmentSerials ShipmentLineSerial[]

  warranties             Warranty[]
  serviceJobSerials      ServiceJobSerial[]
  warrantyClaims         WarrantyClaim[]    @relation("ClaimSerial")
  replacementClaims      WarrantyClaim[]    @relation("ClaimReplacementSerial")
  vendorReturnItems      VendorReturnItem[] @relation("VendorReturnSerial")
  vendorReplacementItems VendorReturnItem[] @relation("VendorReturnReplacementSerial")

  @@unique([variantId, serialNumber])
  @@index([serialNumber])
  @@index([locationId, status])
  @@map("serial_units")
}

/// Lượt giữ hàng
model StockReservation {
  id         String            @id @default(uuid(7)) @db.Uuid
  variantId  String            @map("variant_id") @db.Uuid
  locationId String            @map("location_id") @db.Uuid
  quantity   Int
  source     ReservationSource
  status     ReservationStatus @default(ACTIVE)
  /// FK tới đơn hàng, sẽ thêm ở nhóm 3.5
  orderId    String?           @map("order_id") @db.Uuid
  /// Bắt buộc với ONLINE_CHECKOUT, null với ORDER
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  stockLevel StockLevel @relation(fields: [variantId, locationId], references: [variantId, locationId], onDelete: Restrict)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([variantId, locationId])
  @@index([orderId])
  @@map("stock_reservations")
}

/// Sổ kho bất biến: KHÔNG sửa, KHÔNG xóa (có trigger chặn)
model StockMovement {
  id            String            @id @default(uuid(7)) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  type          StockMovementType
  /// Thay đổi on_hand (+/-). Bằng 0 khi chỉ đổi trạng thái serial.
  quantityDelta Int               @map("quantity_delta")
  onHandAfter   Int               @map("on_hand_after")
  serialUnitId  String?           @map("serial_unit_id") @db.Uuid
  /// Loại chứng từ gốc: GOODS_RECEIPT, STOCK_TRANSFER, STOCKTAKE, ORDER...
  documentType  String?           @map("document_type") @db.VarChar(40)
  documentId    String?           @map("document_id") @db.Uuid
  note          String?
  /// FK tới nhân viên, sẽ thêm ở nhóm 3.3
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  stockLevel StockLevel  @relation(fields: [variantId, locationId], references: [variantId, locationId], onDelete: Restrict)
  serialUnit SerialUnit? @relation(fields: [serialUnitId], references: [id], onDelete: Restrict)

  createdBy Staff? @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([variantId, locationId, createdAt])
  @@index([documentType, documentId])
  @@index([serialUnitId])
  @@map("stock_movements")
}

/// Nhà cung cấp (hãng hoặc nhà phân phối)
model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(200)
  note      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  goodsReceipts GoodsReceipt[]

  vendorReturns VendorReturn[]

  @@map("suppliers")
}

/// Phiếu nhập hàng
model GoodsReceipt {
  id          String         @id @default(uuid(7)) @db.Uuid
  code        String         @unique @db.VarChar(30)
  locationId  String         @map("location_id") @db.Uuid
  supplierId  String?        @map("supplier_id") @db.Uuid
  status      DocumentStatus @default(DRAFT)
  note        String?
  postedAt    DateTime?      @map("posted_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplier Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    GoodsReceiptLine[]

  createdBy Staff? @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([locationId, status])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id            String   @id @default(uuid(7)) @db.Uuid
  receiptId     String   @map("receipt_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  /// Serial quét khi nhập; số phần tử phải bằng quantity nếu biến thể quản lý serial
  serialNumbers String[] @default([]) @map("serial_numbers")

  receipt GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([receiptId, variantId])
  @@map("goods_receipt_lines")
}

/// Phiếu chuyển hàng giữa showroom
model StockTransfer {
  id             String         @id @default(uuid(7)) @db.Uuid
  code           String         @unique @db.VarChar(30)
  fromLocationId String         @map("from_location_id") @db.Uuid
  toLocationId   String         @map("to_location_id") @db.Uuid
  status         TransferStatus @default(DRAFT)
  note           String?
  shippedAt      DateTime?      @map("shipped_at") @db.Timestamptz(3)
  receivedAt     DateTime?      @map("received_at") @db.Timestamptz(3)
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  fromLocation Location            @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location            @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines        StockTransferLine[]

  createdBy Staff? @relation("StockTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, shippedAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id            String   @id @default(uuid(7)) @db.Uuid
  transferId    String   @map("transfer_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  serialNumbers String[] @default([]) @map("serial_numbers")

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, variantId])
  @@map("stock_transfer_lines")
}

/// Phiếu kiểm kê
model Stocktake {
  id          String         @id @default(uuid(7)) @db.Uuid
  code        String         @unique @db.VarChar(30)
  locationId  String         @map("location_id") @db.Uuid
  status      DocumentStatus @default(DRAFT)
  note        String?
  postedAt    DateTime?      @map("posted_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines    StocktakeLine[]

  createdBy Staff? @relation("StocktakeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([locationId, status])
  @@map("stocktakes")
}

model StocktakeLine {
  id          String @id @default(uuid(7)) @db.Uuid
  stocktakeId String @map("stocktake_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  /// Số trên hệ thống tại thời điểm bắt đầu kiểm kê
  systemQty   Int    @map("system_qty")
  countedQty  Int    @map("counted_qty")

  stocktake Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stocktakeId, variantId])
  @@map("stocktake_lines")
}

// ============================================================
// NHÓM 3.3: KHÁCH HÀNG VÀ NHÂN VIÊN
// Khách không đăng nhập; chỉ nhân viên có tài khoản.
// Quyền của từng vai trò định nghĩa trong code (@ktm/shared), không nằm trong database.
// Unique có điều kiện và CHECK viết tay nằm trong migration *_accounts.
// Nhân viên đã có chứng từ kho KHÔNG xóa được (FK Restrict): chỉ chuyển DISABLED.
// ============================================================

enum CustomerType {
  INDIVIDUAL
  BUSINESS

  @@map("customer_type")
}

enum CustomerSource {
  WEBSITE
  ZALO
  STORE
  REFERRAL
  OTHER

  @@map("customer_source")
}

enum StaffRole {
  SUPER_ADMIN
  SALE_STAFF

  @@map("staff_role")
}

enum StaffStatus {
  ACTIVE
  DISABLED

  @@map("staff_status")
}

/// Nhóm khách: dùng để tính giá (nhóm 3.4)
model CustomerGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?
  /// Nhóm gán cho khách mới; chỉ một nhóm được là mặc định
  isDefault   Boolean  @default(false) @map("is_default")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customers Customer[]

  /// Chiết khấu mặc định theo phần vạn (1500 = 15%)
  discountBps   Int                 @default(0) @map("discount_bps")
  variantPrices GroupVariantPrice[]

  @@map("customer_groups")
}

/// Khách hàng (không có tài khoản đăng nhập)
model Customer {
  id                   String         @id @default(uuid(7)) @db.Uuid
  type                 CustomerType   @default(INDIVIDUAL)
  groupId              String         @map("group_id") @db.Uuid
  /// Tên khách lẻ, hoặc tên hiển thị của doanh nghiệp
  fullName             String         @map("full_name") @db.VarChar(200)
  /// Dạng +84xxxxxxxxx. Bắt buộc và duy nhất với khách cá nhân.
  phone                String?        @db.VarChar(16)
  email                String?        @db.VarChar(200)
  companyName          String?        @map("company_name") @db.VarChar(255)
  taxCode              String?        @map("tax_code") @db.VarChar(20)
  /// Địa chỉ ghi trên hóa đơn
  invoiceAddress       String?        @map("invoice_address")
  /// Nhân viên kinh doanh phụ trách
  assignedStaffId      String?        @map("assigned_staff_id") @db.Uuid
  source               CustomerSource @default(WEBSITE)
  note                 String?
  /// Đồng ý chính sách dữ liệu cá nhân (Nghị định 13/2023)
  privacyConsentAt     DateTime?      @map("privacy_consent_at") @db.Timestamptz(3)
  privacyPolicyVersion String?        @map("privacy_policy_version") @db.VarChar(20)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  group         CustomerGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignedStaff Staff?            @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  addresses     CustomerAddress[]
  contacts      CustomerContact[]

  orders Order[]

  warranties     Warranty[]
  warrantyClaims WarrantyClaim[]

  reviews          ProductReview[]
  outboundMessages OutboundMessage[]

  quotes Quote[]

  @@index([groupId])
  @@index([assignedStaffId])
  @@index([phone])
  @@map("customers")
}

/// Địa chỉ theo hành chính 2 cấp (tỉnh/thành, phường/xã) áp dụng từ 01/07/2025
model CustomerAddress {
  id             String   @id @default(uuid(7)) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  recipientName  String   @map("recipient_name") @db.VarChar(200)
  recipientPhone String   @map("recipient_phone") @db.VarChar(16)
  provinceCode   String   @map("province_code") @db.VarChar(10)
  provinceName   String   @map("province_name") @db.VarChar(100)
  wardCode       String   @map("ward_code") @db.VarChar(10)
  wardName       String   @map("ward_name") @db.VarChar(100)
  /// Số nhà, tên đường, tòa nhà...
  street         String
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

/// Người liên hệ của khách doanh nghiệp
model CustomerContact {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  fullName   String   @map("full_name") @db.VarChar(200)
  phone      String?  @db.VarChar(16)
  email      String?  @db.VarChar(200)
  position   String?  @db.VarChar(120)
  isPrimary  Boolean  @default(false) @map("is_primary")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  quotes Quote[]

  @@index([customerId])
  @@map("customer_contacts")
}

/// Nhân viên: đối tượng duy nhất đăng nhập hệ thống
model Staff {
  id                String      @id @default(uuid(7)) @db.Uuid
  /// Luôn viết thường
  email             String      @unique @db.VarChar(200)
  fullName          String      @map("full_name") @db.VarChar(200)
  phone             String?     @db.VarChar(16)
  /// Argon2id; KHÔNG bao giờ trả về qua API
  passwordHash      String      @map("password_hash")
  role              StaffRole   @default(SALE_STAFF)
  status            StaffStatus @default(ACTIVE)
  failedLoginCount  Int         @default(0) @map("failed_login_count")
  lockedUntil       DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?   @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime    @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          StaffSession[]
  assignedCustomers Customer[]
  goodsReceipts     GoodsReceipt[]  @relation("GoodsReceiptCreatedBy")
  stockTransfers    StockTransfer[] @relation("StockTransferCreatedBy")
  stocktakes        Stocktake[]     @relation("StocktakeCreatedBy")
  stockMovements    StockMovement[] @relation("StockMovementCreatedBy")

  saleCampaigns  SaleCampaign[]  @relation("SaleCampaignCreatedBy")
  vouchers       Voucher[]       @relation("VoucherCreatedBy")
  giftPromotions GiftPromotion[] @relation("GiftPromotionCreatedBy")

  createdOrders           Order[]              @relation("OrderCreatedBy")
  assignedOrders          Order[]              @relation("OrderAssignedStaff")
  orderStatusChanges      OrderStatusHistory[]
  receivedPayments        Payment[]            @relation("PaymentReceivedBy")
  matchedBankTransactions BankTransaction[]    @relation("BankTransactionMatchedBy")

  createdShipments   Shipment[] @relation("ShipmentCreatedBy")
  deliveredShipments Shipment[] @relation("ShipmentDeliveredBy")

  technicianProfile     Technician?
  createdServiceJobs    ServiceJob[]    @relation("ServiceJobCreatedBy")
  createdWarrantyClaims WarrantyClaim[] @relation("WarrantyClaimCreatedBy")
  createdVendorReturns  VendorReturn[]  @relation("VendorReturnCreatedBy")

  uploadedMedia         MediaAsset[]        @relation("MediaUploadedBy")
  authoredPosts         Post[]              @relation("PostAuthor")
  updatedPages          Page[]              @relation("PageUpdatedBy")
  createdPolicyVersions PolicyVersion[]     @relation("PolicyVersionCreatedBy")
  createdRedirects      UrlRedirect[]       @relation("RedirectCreatedBy")
  moderatedReviews      ProductReview[]     @relation("ReviewModeratedBy")
  updatedSettings       SystemSetting[]     @relation("SettingUpdatedBy")
  notifications         StaffNotification[]
  auditLogs             AuditLog[]

  createdQuotes  Quote[] @relation("QuoteCreatedBy")
  approvedQuotes Quote[] @relation("QuoteApprovedBy")
  sentQuotes     Quote[] @relation("QuoteSentBy")

  @@map("staff")
}

/// Phiên đăng nhập (refresh token xoay vòng)
model StaffSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  /// SHA-256 (hex) của refresh token; KHÔNG lưu token gốc
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  /// Mọi phiên sinh ra từ cùng một lần đăng nhập dùng chung family_id
  familyId     String    @map("family_id") @db.Uuid
  /// Phiên mới thay thế phiên này khi làm mới token
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ipAddress    String?   @map("ip_address") @db.Inet
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// LOGOUT, ROTATED, REUSE_DETECTED, ADMIN, PASSWORD_CHANGED
  revokeReason String?   @map("revoke_reason") @db.VarChar(40)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([familyId])
  @@map("staff_sessions")
}

// ============================================================
// NHÓM 3.4: GIÁ VÀ KHUYẾN MÃI
// Quy tắc: lấy giá THẤP NHẤT giữa các lớp (lẻ/khu vực, nhóm, số lượng, flash sale),
// không cộng dồn. Báo giá dự án thay thế tất cả. Voucher áp dụng sau cùng trên tổng đơn.
// Giá tính theo % làm tròn XUỐNG hàng nghìn. Phần trăm lưu theo phần vạn (bps).
// CHECK, EXCLUDE và trigger viết tay nằm trong migration *_pricing.
// Cần extension btree_gist. sale_campaign_items.starts_at/ends_at/is_published do trigger quản lý.
// ============================================================

enum PromotionStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("promotion_status")
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT

  @@map("discount_type")
}

enum VoucherStatus {
  ACTIVE
  DISABLED

  @@map("voucher_status")
}

enum VoucherTargetType {
  PRODUCT
  CATEGORY
  BRAND

  @@map("voucher_target_type")
}

enum RedemptionStatus {
  /// Đã áp vào đơn chưa hoàn tất
  RESERVED
  /// Đơn đã thanh toán hoặc hoàn tất
  USED
  /// Đơn bị hủy, trả lại lượt dùng
  RELEASED

  @@map("redemption_status")
}

/// Giá theo khu vực (chủ yếu cho combo có lắp đặt); thay cho giá lẻ ở khu vực đó
model VariantRegionPrice {
  variantId String   @map("variant_id") @db.Uuid
  region    Region
  price     BigInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, region])
  @@map("variant_region_prices")
}

/// Giá riêng của một nhóm khách cho một biến thể; thay cho chiết khấu % của nhóm
model GroupVariantPrice {
  groupId   String   @map("group_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  price     BigInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  group   CustomerGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([groupId, variantId])
  @@index([variantId])
  @@map("group_variant_prices")
}

/// Bậc giá theo số lượng (mọi khách): giá cố định HOẶC giảm %
model QuantityPriceTier {
  id          String   @id @default(uuid(7)) @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  minQuantity Int      @map("min_quantity")
  fixedPrice  BigInt?  @map("fixed_price")
  discountBps Int?     @map("discount_bps")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQuantity])
  @@map("quantity_price_tiers")
}

/// Đợt flash sale
model SaleCampaign {
  id          String          @id @default(uuid(7)) @db.Uuid
  name        String          @db.VarChar(200)
  description String?
  startsAt    DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime        @map("ends_at") @db.Timestamptz(3)
  status      PromotionStatus @default(DRAFT)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy Staff?             @relation("SaleCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     SaleCampaignItem[]

  @@index([status, startsAt, endsAt])
  @@map("sale_campaigns")
}

/// Sản phẩm trong đợt flash sale.
/// starts_at, ends_at, is_published được trigger TỰ ĐỒNG BỘ từ sale_campaigns (giá trị gửi lên sẽ bị ghi đè).
model SaleCampaignItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  campaignId    String   @map("campaign_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  salePrice     BigInt   @map("sale_price")
  /// Số lượng tối đa bán theo giá sale; null = không giới hạn (vẫn bị giới hạn bởi tồn kho)
  quantityLimit Int?     @map("quantity_limit")
  soldQuantity  Int      @default(0) @map("sold_quantity")
  perOrderLimit Int?     @map("per_order_limit")
  startsAt      DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime @map("ends_at") @db.Timestamptz(3)
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign SaleCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  orderLines OrderLine[]

  @@unique([campaignId, variantId])
  @@index([variantId, isPublished, startsAt, endsAt])
  @@map("sale_campaign_items")
}

/// Mã giảm giá
model Voucher {
  id                 String        @id @default(uuid(7)) @db.Uuid
  /// Chữ in hoa, số, gạch ngang
  code               String        @unique @db.VarChar(40)
  name               String        @db.VarChar(200)
  description        String?
  discountType       DiscountType  @map("discount_type")
  /// Dùng khi PERCENT
  discountBps        Int?          @map("discount_bps")
  /// Dùng khi FIXED_AMOUNT
  discountAmount     BigInt?       @map("discount_amount")
  /// Mức giảm tối đa cho PERCENT
  maxDiscount        BigInt?       @map("max_discount")
  minOrderAmount     BigInt        @default(0) @map("min_order_amount")
  startsAt           DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime      @map("ends_at") @db.Timestamptz(3)
  /// Tổng lượt dùng tối đa; null = không giới hạn
  usageLimit         Int?          @map("usage_limit")
  usedCount          Int           @default(0) @map("used_count")
  /// Lượt dùng tối đa mỗi số điện thoại; null = không giới hạn
  perPhoneLimit      Int?          @default(1) @map("per_phone_limit")
  /// Có được áp cho hàng đang flash sale không
  appliesToSaleItems Boolean       @default(false) @map("applies_to_sale_items")
  status             VoucherStatus @default(ACTIVE)
  createdById        String?       @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   Staff?              @relation("VoucherCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  targets     VoucherTarget[]
  redemptions VoucherRedemption[]

  @@index([status, startsAt, endsAt])
  @@map("vouchers")
}

/// Phạm vi áp dụng voucher. Không có dòng nào = áp dụng cho toàn bộ sản phẩm.
model VoucherTarget {
  id         String            @id @default(uuid(7)) @db.Uuid
  voucherId  String            @map("voucher_id") @db.Uuid
  targetType VoucherTargetType @map("target_type")
  productId  String?           @map("product_id") @db.Uuid
  categoryId String?           @map("category_id") @db.Uuid
  brandId    String?           @map("brand_id") @db.Uuid

  voucher  Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@map("voucher_targets")
}

/// Lượt dùng voucher
model VoucherRedemption {
  id             String           @id @default(uuid(7)) @db.Uuid
  voucherId      String           @map("voucher_id") @db.Uuid
  /// FK tới đơn hàng, sẽ thêm ở nhóm 3.5
  orderId        String?          @map("order_id") @db.Uuid
  phone          String           @db.VarChar(16)
  discountAmount BigInt           @map("discount_amount")
  status         RedemptionStatus @default(RESERVED)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([voucherId, phone])
  @@index([orderId])
  @@map("voucher_redemptions")
}

/// Chương trình quà tặng kèm (tặng một lần mỗi đơn)
model GiftPromotion {
  id             String          @id @default(uuid(7)) @db.Uuid
  name           String          @db.VarChar(200)
  description    String?
  startsAt       DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime        @map("ends_at") @db.Timestamptz(3)
  status         PromotionStatus @default(DRAFT)
  /// Điều kiện theo giá trị đơn; null = không xét
  minOrderAmount BigInt?         @map("min_order_amount")
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy Staff?        @relation("GiftPromotionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  triggers  GiftTrigger[]
  items     GiftItem[]

  @@index([status, startsAt, endsAt])
  @@map("gift_promotions")
}

/// Điều kiện theo sản phẩm: đơn có ÍT NHẤT MỘT biến thể đạt số lượng tối thiểu
model GiftTrigger {
  id          String @id @default(uuid(7)) @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  minQuantity Int    @default(1) @map("min_quantity")

  promotion GiftPromotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([promotionId, variantId])
  @@map("gift_triggers")
}

/// Quà tặng: biến thể thật trong kho, giá 0 trên đơn, có trừ tồn kho
model GiftItem {
  promotionId String @map("promotion_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  quantity    Int    @default(1)

  promotion GiftPromotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([promotionId, variantId])
  @@map("gift_items")
}

// ============================================================
// NHÓM 3.5A: ĐƠN HÀNG VÀ THANH TOÁN
// Giá trên dòng đơn là giá CHƯA VAT (vat_mode = EXCLUSIVE_ON_REQUEST):
// VAT chỉ cộng khi khách yêu cầu hóa đơn. Thuế tính và làm tròn theo TỪNG DÒNG.
// Kết quả VNPay chỉ tin theo IPN đã kiểm tra chữ ký, không tin trang quay về.
// CHECK, unique có điều kiện, trigger và hàm next_document_number nằm trong migration *_orders.
// order_status_history bất biến (hàm forbid_modification dùng chung). Tổng tiền của đơn phải khớp tổng các dòng: API chịu trách nhiệm.
// ============================================================

enum SalesChannel {
  WEBSITE
  ZALO
  STORE
  PROJECT

  @@map("sales_channel")
}

/// Quy trình (Bước 6): Chờ xác nhận → Đã xác nhận → Đã đặt hãng → Hàng về → Đang giao lắp → Hoàn tất.
/// PENDING_PAYMENT không dùng: công ty không nhận thanh toán online.
enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  /// Đã đặt hàng với hãng, chờ hãng giao về công ty
  ORDERED_FROM_BRAND
  /// Hãng đã giao hàng về công ty, chờ hẹn giao lắp cho khách
  GOODS_ARRIVED
  /// Đang giao và lắp đặt cùng kỹ thuật của hãng
  FULFILLING
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum FulfillmentType {
  /// Mua tại showroom, mang về ngay
  TAKE_AWAY
  /// Giao hàng
  DELIVERY
  /// Đặt trước, đến showroom nhận
  STORE_PICKUP

  @@map("fulfillment_type")
}

enum VatMode {
  /// Giá chưa VAT, chỉ cộng VAT khi khách yêu cầu hóa đơn
  EXCLUSIVE_ON_REQUEST
  /// Giá đã gồm VAT (dự phòng nếu công ty đổi chính sách)
  INCLUSIVE

  @@map("vat_mode")
}

enum OrderLineType {
  PRODUCT
  BUNDLE
  BUNDLE_COMPONENT
  INSTALLATION
  GIFT

  @@map("order_line_type")
}

enum PriceSource {
  RETAIL
  REGION
  GROUP_PERCENT
  GROUP_FIXED
  QUANTITY_TIER
  FLASH_SALE
  QUOTE
  INSTALLATION_RATE
  MANUAL
  ZERO

  @@map("price_source")
}

enum PaymentMethod {
  CASH
  COD
  BANK_TRANSFER
  VNPAY

  @@map("payment_method")
}

enum PaymentPurpose {
  DEPOSIT
  BALANCE
  FULL
  REFUND

  @@map("payment_purpose")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED

  @@map("payment_status")
}

enum BankMatchStatus {
  UNMATCHED
  MATCHED
  IGNORED

  @@map("bank_match_status")
}

/// Bộ đếm mã chứng từ theo tiền tố và kỳ (vd: DH + 260917). Dùng qua hàm next_document_number().
model DocumentSequence {
  prefix    String   @db.VarChar(10)
  periodKey String   @map("period_key") @db.VarChar(8)
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([prefix, periodKey])
  @@map("document_sequences")
}

/// Đơn hàng: chụp lại thông tin khách, địa chỉ, hóa đơn tại thời điểm đặt
model Order {
  id                    String          @id @default(uuid(7)) @db.Uuid
  code                  String          @unique @db.VarChar(30)
  channel               SalesChannel
  status                OrderStatus     @default(PENDING_CONFIRMATION)
  fulfillmentType       FulfillmentType @map("fulfillment_type")
  /// Null chỉ khi mua mang về mà khách không để lại thông tin
  customerId            String?         @map("customer_id") @db.Uuid
  customerName          String?         @map("customer_name") @db.VarChar(200)
  customerPhone         String?         @map("customer_phone") @db.VarChar(16)
  /// Showroom xuất hàng: bắt buộc với TAKE_AWAY và STORE_PICKUP
  fulfillmentLocationId String?         @map("fulfillment_location_id") @db.Uuid

  // Địa chỉ giao hàng (bắt buộc với DELIVERY)
  shipRecipientName  String? @map("ship_recipient_name") @db.VarChar(200)
  shipRecipientPhone String? @map("ship_recipient_phone") @db.VarChar(16)
  shipProvinceCode   String? @map("ship_province_code") @db.VarChar(10)
  shipProvinceName   String? @map("ship_province_name") @db.VarChar(100)
  shipWardCode       String? @map("ship_ward_code") @db.VarChar(10)
  shipWardName       String? @map("ship_ward_name") @db.VarChar(100)
  shipStreet         String? @map("ship_street")
  /// Khu vực lắp đặt/tự giao; null nếu ngoài TP.HCM và Hà Nội
  shipRegion         Region? @map("ship_region")
  /// Địa chỉ khách gõ tự do trên web; nhân viên chuẩn hóa thành tỉnh/phường khi xác nhận đơn
  shipAddressRaw     String? @map("ship_address_raw")

  // Làm việc với hãng (công ty không giữ kho: nhận đơn rồi mới đặt hãng)
  /// Mã đơn hoặc số phiếu bên hãng, nếu hãng có cấp
  brandOrderRef       String?   @map("brand_order_ref") @db.VarChar(100)
  brandOrderedAt      DateTime? @map("brand_ordered_at") @db.Timestamptz(3)
  goodsArrivedAt      DateTime? @map("goods_arrived_at") @db.Timestamptz(3)
  /// Ngày giờ hẹn giao lắp với khách
  scheduledAt         DateTime? @map("scheduled_at") @db.Timestamptz(3)
  /// Kỹ thuật viên của hãng đi lắp: tên, số điện thoại, ghi chú
  brandTechnicianNote String?   @map("brand_technician_note")
  /// Nhân viên phụ trách: tư vấn, đặt hãng, đi giao cùng kỹ thuật hãng
  assignedStaffId     String?   @map("assigned_staff_id") @db.Uuid

  // Thuế và hóa đơn
  vatMode             VatMode @default(EXCLUSIVE_ON_REQUEST) @map("vat_mode")
  vatInvoiceRequested Boolean @default(false) @map("vat_invoice_requested")
  invoiceBuyerName    String? @map("invoice_buyer_name") @db.VarChar(200)
  invoiceCompanyName  String? @map("invoice_company_name") @db.VarChar(255)
  invoiceTaxCode      String? @map("invoice_tax_code") @db.VarChar(20)
  invoiceAddress      String? @map("invoice_address")
  invoiceEmail        String? @map("invoice_email") @db.VarChar(200)

  // Tiền (VND)
  subtotal        BigInt @default(0)
  discountTotal   BigInt @default(0) @map("discount_total")
  shippingFee     BigInt @default(0) @map("shipping_fee")
  vatTotal        BigInt @default(0) @map("vat_total")
  grandTotal      BigInt @default(0) @map("grand_total")
  /// Đã thu (sau khi trừ hoàn tiền)
  paidTotal       BigInt @default(0) @map("paid_total")
  depositRequired BigInt @default(0) @map("deposit_required")

  /// Chống đặt trùng khi khách bấm nhiều lần
  idempotencyKey  String? @unique @map("idempotency_key") @db.VarChar(64)
  customerNote    String? @map("customer_note")
  internalNote    String? @map("internal_note")
  needsAttention  Boolean @default(false) @map("needs_attention")
  attentionReason String? @map("attention_reason") @db.VarChar(200)
  placedIp        String? @map("placed_ip") @db.Inet
  userAgent       String? @map("user_agent") @db.VarChar(500)
  /// Nhân viên tạo đơn; null với đơn khách tự đặt
  createdById     String? @map("created_by_id") @db.Uuid
  /// Khóa lạc quan: tăng 1 mỗi lần cập nhật
  version         Int     @default(1)

  placedAt     DateTime  @default(now()) @map("placed_at") @db.Timestamptz(3)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?   @map("cancel_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fulfillmentLocation Location?            @relation(fields: [fulfillmentLocationId], references: [id], onDelete: Restrict)
  createdBy           Staff?               @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedStaff       Staff?               @relation("OrderAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  lines               OrderLine[]
  payments            Payment[]
  statusHistory       OrderStatusHistory[]
  reservations        StockReservation[]
  voucherRedemptions  VoucherRedemption[]

  shipments Shipment[]

  serviceJobs ServiceJob[]
  warranties  Warranty[]

  outboundMessages OutboundMessage[]

  /// Báo giá gốc (đơn công trình); mỗi báo giá chỉ tạo một đơn
  quoteId String? @unique @map("quote_id") @db.Uuid
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status, placedAt])
  @@index([customerPhone])
  @@index([channel, placedAt])
  @@index([assignedStaffId, status])
  @@map("orders")
}

/// Dòng đơn: giá, nguồn giá, voucher phân bổ và thuế được chụp lại
model OrderLine {
  id                  String        @id @default(uuid(7)) @db.Uuid
  orderId             String        @map("order_id") @db.Uuid
  /// Dòng cha: combo của BUNDLE_COMPONENT, khóa của INSTALLATION
  parentLineId        String?       @map("parent_line_id") @db.Uuid
  lineType            OrderLineType @map("line_type")
  /// Null chỉ với INSTALLATION
  variantId           String?       @map("variant_id") @db.Uuid
  sku                 String?       @db.VarChar(64)
  name                String        @db.VarChar(255)
  quantity            Int
  /// Giá niêm yết tại thời điểm bán (để hiển thị "trị giá")
  listPrice           BigInt        @map("list_price")
  /// Giá bán cuối cùng mỗi đơn vị, CHƯA VAT
  unitPrice           BigInt        @map("unit_price")
  priceSource         PriceSource   @map("price_source")
  saleCampaignItemId  String?       @map("sale_campaign_item_id") @db.Uuid
  /// unit_price x quantity
  lineSubtotal        BigInt        @map("line_subtotal")
  /// Phần voucher phân bổ cho dòng này
  discountAllocated   BigInt        @default(0) @map("discount_allocated")
  /// line_subtotal - discount_allocated
  lineTotal           BigInt        @map("line_total")
  vatRateBps          Int           @map("vat_rate_bps")
  vatAmount           BigInt        @default(0) @map("vat_amount")
  installationClassId String?       @map("installation_class_id") @db.Uuid
  installationRegion  Region?       @map("installation_region")
  /// Số lượng đã giao (cập nhật khi giao hàng)
  quantityShipped     Int           @default(0) @map("quantity_shipped")
  /// Serial các máy đã giao (không bắt buộc): để báo hãng khi khách cần bảo hành
  serialNumbers       String[]      @default([]) @map("serial_numbers")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parentLine        OrderLine?         @relation("OrderLineTree", fields: [parentLineId], references: [id], onDelete: Cascade)
  childLines        OrderLine[]        @relation("OrderLineTree")
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  saleCampaignItem  SaleCampaignItem?  @relation(fields: [saleCampaignItemId], references: [id], onDelete: Restrict)
  installationClass InstallationClass? @relation(fields: [installationClassId], references: [id], onDelete: Restrict)

  shipmentLines ShipmentLine[]

  serviceJobs ServiceJob[]
  warranties  Warranty[]

  review         ProductReview?
  reviewRequests ReviewRequest[]

  quoteLineId String?    @map("quote_line_id") @db.Uuid
  quoteLine   QuoteLine? @relation(fields: [quoteLineId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@index([parentLineId])
  @@map("order_lines")
}

/// Lịch sử trạng thái đơn (bất biến, có trigger chặn sửa/xóa)
model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  staffId    String?      @map("staff_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Mỗi lần thu hoặc hoàn tiền
model Payment {
  id                    String         @id @default(uuid(7)) @db.Uuid
  orderId               String         @map("order_id") @db.Uuid
  method                PaymentMethod
  purpose               PaymentPurpose
  status                PaymentStatus  @default(PENDING)
  /// Luôn dương; hoàn tiền xác định bằng purpose = REFUND
  amount                BigInt
  /// Nội dung chuyển khoản riêng cho lần thu (VietQR)
  transferContent       String?        @unique @map("transfer_content") @db.VarChar(40)
  /// Mã giao dịch do hệ thống gửi cổng thanh toán (vnp_TxnRef)
  providerTxnRef        String?        @unique @map("provider_txn_ref") @db.VarChar(64)
  /// Mã giao dịch do cổng thanh toán trả về
  providerTransactionNo String?        @map("provider_transaction_no") @db.VarChar(64)
  providerResponseCode  String?        @map("provider_response_code") @db.VarChar(10)
  expiresAt             DateTime?      @map("expires_at") @db.Timestamptz(3)
  paidAt                DateTime?      @map("paid_at") @db.Timestamptz(3)
  receivedById          String?        @map("received_by_id") @db.Uuid
  note                  String?
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receivedBy       Staff?                @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  bankTransactions BankTransaction[]
  webhookEvents    PaymentWebhookEvent[]

  @@index([orderId])
  @@index([status, expiresAt])
  @@map("payments")
}

/// Giao dịch ngân hàng nhận về để đối chiếu chuyển khoản
model BankTransaction {
  id               String          @id @default(uuid(7)) @db.Uuid
  /// Nguồn dữ liệu (dịch vụ theo dõi tài khoản ngân hàng)
  provider         String          @db.VarChar(40)
  externalId       String          @map("external_id") @db.VarChar(100)
  accountNumber    String?         @map("account_number") @db.VarChar(30)
  amount           BigInt
  content          String
  transactedAt     DateTime        @map("transacted_at") @db.Timestamptz(3)
  matchStatus      BankMatchStatus @default(UNMATCHED) @map("match_status")
  matchedPaymentId String?         @map("matched_payment_id") @db.Uuid
  matchedById      String?         @map("matched_by_id") @db.Uuid
  rawPayload       Json            @map("raw_payload")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  matchedPayment Payment? @relation(fields: [matchedPaymentId], references: [id], onDelete: Restrict)
  matchedBy      Staff?   @relation("BankTransactionMatchedBy", fields: [matchedById], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([matchStatus, transactedAt])
  @@map("bank_transactions")
}

/// Thông báo từ cổng thanh toán (IPN); mỗi thông báo chỉ xử lý một lần
model PaymentWebhookEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  provider       String    @db.VarChar(40)
  /// Khóa chống xử lý trùng, vd: vnp_TxnRef + vnp_TransactionNo
  eventKey       String    @map("event_key") @db.VarChar(200)
  paymentId      String?   @map("payment_id") @db.Uuid
  signatureValid Boolean   @map("signature_valid")
  payload        Json
  /// Kết quả xử lý: OK, AMOUNT_MISMATCH, ALREADY_CONFIRMED...
  result         String?   @db.VarChar(40)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, eventKey])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

// ============================================================
// NHÓM 3.5B: GIAO HÀNG
// order_lines.quantity_shipped do TRIGGER tự cập nhật từ shipment_lines (không ghi tay).
// shipment_lines không cho UPDATE: muốn sửa thì xóa rồi thêm lại.
// Serial được gắn khi quét lúc xuất hàng (shipment_line_serials).
// CHECK và trigger viết tay nằm trong migration *_shipments.
// Hủy lần giao (status -> CANCELLED) tự trả lại quantity_shipped; lần giao đã hủy không mở lại được.
// ============================================================

enum ShipmentMethod {
  /// Nhân viên tự giao (nội thành TP.HCM, Hà Nội)
  OWN_DELIVERY
  /// Gửi đơn vị vận chuyển (tỉnh xa)
  CARRIER
  /// Khách nhận tại showroom
  CUSTOMER_PICKUP

  @@map("shipment_method")
}

enum Carrier {
  GHN
  GHTK
  VIETTEL_POST
  OTHER

  @@map("carrier")
}

enum ShipmentStatus {
  PENDING
  PACKED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED

  @@map("shipment_status")
}

/// Một lần giao hàng (một đơn có thể giao nhiều lần)
model Shipment {
  id                 String         @id @default(uuid(7)) @db.Uuid
  code               String         @unique @db.VarChar(30)
  orderId            String         @map("order_id") @db.Uuid
  fromLocationId     String         @map("from_location_id") @db.Uuid
  method             ShipmentMethod
  carrier            Carrier?
  trackingCode       String?        @map("tracking_code") @db.VarChar(60)
  status             ShipmentStatus @default(PENDING)
  /// Số tiền cần thu hộ khi giao
  codAmount          BigInt         @default(0) @map("cod_amount")
  /// Số tiền thu hộ thực nhận (đơn vị vận chuyển chuyển về hoặc nhân viên nộp lại)
  codCollectedAmount BigInt?        @map("cod_collected_amount")
  codCollectedAt     DateTime?      @map("cod_collected_at") @db.Timestamptz(3)
  /// Chi phí thực trả cho đơn vị vận chuyển
  carrierFee         BigInt?        @map("carrier_fee")
  /// Nhân viên giao (khi tự giao)
  deliveredById      String?        @map("delivered_by_id") @db.Uuid
  failedReason       String?        @map("failed_reason")
  note               String?
  createdById        String?        @map("created_by_id") @db.Uuid
  packedAt           DateTime?      @map("packed_at") @db.Timestamptz(3)
  shippedAt          DateTime?      @map("shipped_at") @db.Timestamptz(3)
  deliveredAt        DateTime?      @map("delivered_at") @db.Timestamptz(3)
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromLocation Location       @relation(fields: [fromLocationId], references: [id], onDelete: Restrict)
  deliveredBy  Staff?         @relation("ShipmentDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  createdBy    Staff?         @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines        ShipmentLine[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([fromLocationId, status])
  @@map("shipments")
}

/// Dòng đơn được giao trong một lần giao
model ShipmentLine {
  id          String @id @default(uuid(7)) @db.Uuid
  shipmentId  String @map("shipment_id") @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid
  quantity    Int

  shipment  Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLine OrderLine            @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  serials   ShipmentLineSerial[]

  @@unique([shipmentId, orderLineId])
  @@index([orderLineId])
  @@map("shipment_lines")
}

/// Serial đã quét khi xuất hàng
model ShipmentLineSerial {
  shipmentLineId String @map("shipment_line_id") @db.Uuid
  serialUnitId   String @map("serial_unit_id") @db.Uuid

  shipmentLine ShipmentLine @relation(fields: [shipmentLineId], references: [id], onDelete: Cascade)
  serialUnit   SerialUnit   @relation(fields: [serialUnitId], references: [id], onDelete: Restrict)

  @@id([shipmentLineId, serialUnitId])
  @@index([serialUnitId])
  @@map("shipment_line_serials")
}

// ============================================================
// NHÓM 3.7: LẮP ĐẶT, BẢO HÀNH, GỬI TRẢ HÃNG
// Kỹ thuật viên chưa có tài khoản (staff_id để nối sau).
// Bảo hành tạo khi giao hàng (PENDING_ACTIVATION), kích hoạt khi lắp xong;
// đơn không lắp thì kích hoạt ngay khi giao. Không tự kích hoạt nếu chưa lắp.
// Hết hạn = ends_on < hôm nay (không đổi trạng thái).
// Đổi máy: chỉ khi lỗi NSX và còn trong hạn đổi; phiếu mới giữ nguyên ends_on.
// service_job_technicians: thời gian và is_active do TRIGGER đồng bộ; EXCLUDE chống trùng lịch.
// CHECK, EXCLUDE, unique có điều kiện và trigger nằm trong migration *_after_sales.
// ============================================================

enum ServiceJobType {
  INSTALLATION
  WARRANTY_VISIT
  REINSTALL

  @@map("service_job_type")
}

enum ServiceJobStatus {
  PENDING_SCHEDULE
  SCHEDULED
  COMPLETED
  FAILED
  CANCELLED

  @@map("service_job_status")
}

enum WarrantyStatus {
  PENDING_ACTIVATION
  ACTIVE
  REPLACED
  VOIDED

  @@map("warranty_status")
}

enum WarrantySource {
  INSTALLATION
  DELIVERY
  REPLACEMENT

  @@map("warranty_source")
}

enum ClaimStatus {
  RECEIVED
  INSPECTING
  REPAIRING
  AT_VENDOR
  RESOLVED
  REJECTED
  CANCELLED

  @@map("claim_status")
}

enum InspectionResult {
  MANUFACTURER_DEFECT
  USER_DAMAGE
  NO_FAULT

  @@map("inspection_result")
}

enum ClaimResolution {
  EXCHANGED
  REPAIRED
  VENDOR_REPAIRED
  VENDOR_REPLACED
  NO_FAULT_FOUND
  REJECTED

  @@map("claim_resolution")
}

enum VendorReturnStatus {
  DRAFT
  SENT
  COMPLETED
  CANCELLED

  @@map("vendor_return_status")
}

enum VendorReturnOutcome {
  PENDING
  REPAIRED
  REPLACED
  REFUNDED
  REJECTED

  @@map("vendor_return_outcome")
}

/// Kỹ thuật viên (chưa có tài khoản đăng nhập)
model Technician {
  id             String   @id @default(uuid(7)) @db.Uuid
  fullName       String   @map("full_name") @db.VarChar(200)
  phone          String   @db.VarChar(16)
  region         Region
  homeLocationId String?  @map("home_location_id") @db.Uuid
  /// Nối với tài khoản nhân viên khi cấp quyền sau này
  staffId        String?  @unique @map("staff_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  homeLocation Location?              @relation(fields: [homeLocationId], references: [id], onDelete: SetNull)
  staff        Staff?                 @relation(fields: [staffId], references: [id], onDelete: SetNull)
  jobs         ServiceJobTechnician[]

  @@index([region, isActive])
  @@map("technicians")
}

/// Lịch dịch vụ tại nhà khách: lắp đặt, kiểm tra bảo hành, lắp lại
model ServiceJob {
  id              String           @id @default(uuid(7)) @db.Uuid
  code            String           @unique @db.VarChar(30)
  jobType         ServiceJobType   @map("job_type")
  status          ServiceJobStatus @default(PENDING_SCHEDULE)
  orderId         String?          @map("order_id") @db.Uuid
  /// Dòng lắp đặt (INSTALLATION) của đơn
  orderLineId     String?          @map("order_line_id") @db.Uuid
  warrantyClaimId String?          @map("warranty_claim_id") @db.Uuid
  region          Region
  contactName     String           @map("contact_name") @db.VarChar(200)
  contactPhone    String           @map("contact_phone") @db.VarChar(16)
  address         String
  scheduledStart  DateTime?        @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd    DateTime?        @map("scheduled_end") @db.Timestamptz(3)
  resultNote      String?          @map("result_note")
  /// Ảnh sau khi làm: ["url1", "url2"]
  photos          Json             @default("[]")
  failedReason    String?          @map("failed_reason")
  cancelReason    String?          @map("cancel_reason")
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  createdById     String?          @map("created_by_id") @db.Uuid
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  order               Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLine           OrderLine?             @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  warrantyClaim       WarrantyClaim?         @relation(fields: [warrantyClaimId], references: [id], onDelete: Restrict)
  createdBy           Staff?                 @relation("ServiceJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  technicians         ServiceJobTechnician[]
  serials             ServiceJobSerial[]
  activatedWarranties Warranty[]

  @@index([status, scheduledStart])
  @@index([region, scheduledStart])
  @@index([orderId])
  @@index([orderLineId])
  @@index([warrantyClaimId])
  @@map("service_jobs")
}

/// Phân công kỹ thuật viên. scheduled_start, scheduled_end, is_active do trigger đồng bộ.
model ServiceJobTechnician {
  jobId          String    @map("job_id") @db.Uuid
  technicianId   String    @map("technician_id") @db.Uuid
  isLead         Boolean   @default(false) @map("is_lead")
  scheduledStart DateTime? @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime? @map("scheduled_end") @db.Timestamptz(3)
  isActive       Boolean   @default(false) @map("is_active")

  job        ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@id([jobId, technicianId])
  @@index([technicianId, isActive])
  @@map("service_job_technicians")
}

/// Serial được lắp trong một lịch lắp đặt
model ServiceJobSerial {
  jobId        String @map("job_id") @db.Uuid
  serialUnitId String @map("serial_unit_id") @db.Uuid

  job        ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  serialUnit SerialUnit @relation(fields: [serialUnitId], references: [id], onDelete: Restrict)

  @@id([jobId, serialUnitId])
  @@index([serialUnitId])
  @@map("service_job_serials")
}

/// Phiếu bảo hành theo serial
model Warranty {
  id                 String         @id @default(uuid(7)) @db.Uuid
  serialUnitId       String         @map("serial_unit_id") @db.Uuid
  orderId            String?        @map("order_id") @db.Uuid
  orderLineId        String?        @map("order_line_id") @db.Uuid
  customerId         String?        @map("customer_id") @db.Uuid
  /// Số điện thoại dùng để tra cứu
  phone              String?        @db.VarChar(16)
  months             Int
  status             WarrantyStatus @default(PENDING_ACTIVATION)
  source             WarrantySource
  startsOn           DateTime?      @map("starts_on") @db.Date
  endsOn             DateTime?      @map("ends_on") @db.Date
  activatedAt        DateTime?      @map("activated_at") @db.Timestamptz(3)
  activatedByJobId   String?        @map("activated_by_job_id") @db.Uuid
  /// Phiếu cũ khi đổi máy
  previousWarrantyId String?        @unique @map("previous_warranty_id") @db.Uuid
  voidedReason       String?        @map("voided_reason")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  serialUnit          SerialUnit      @relation(fields: [serialUnitId], references: [id], onDelete: Restrict)
  order               Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLine           OrderLine?      @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  activatedByJob      ServiceJob?     @relation(fields: [activatedByJobId], references: [id], onDelete: Restrict)
  previousWarranty    Warranty?       @relation("WarrantyReplacement", fields: [previousWarrantyId], references: [id], onDelete: Restrict)
  nextWarranty        Warranty?       @relation("WarrantyReplacement")
  claims              WarrantyClaim[] @relation("ClaimWarranty")
  replacementForClaim WarrantyClaim?  @relation("ClaimReplacementWarranty")

  @@index([serialUnitId])
  @@index([phone])
  @@index([customerId])
  @@index([orderId])
  @@map("warranties")
}

/// Yêu cầu bảo hành của khách
model WarrantyClaim {
  id                      String            @id @default(uuid(7)) @db.Uuid
  code                    String            @unique @db.VarChar(30)
  warrantyId              String            @map("warranty_id") @db.Uuid
  serialUnitId            String            @map("serial_unit_id") @db.Uuid
  customerId              String?           @map("customer_id") @db.Uuid
  contactName             String            @map("contact_name") @db.VarChar(200)
  contactPhone            String            @map("contact_phone") @db.VarChar(16)
  issueDescription        String            @map("issue_description")
  photos                  Json              @default("[]")
  status                  ClaimStatus       @default(RECEIVED)
  receivedLocationId      String            @map("received_location_id") @db.Uuid
  receivedAt              DateTime          @default(now()) @map("received_at") @db.Timestamptz(3)
  /// Tính lúc tiếp nhận: còn trong hạn đổi máy hay không
  withinExchangeWindow    Boolean           @map("within_exchange_window")
  inspectionResult        InspectionResult? @map("inspection_result")
  inspectionNote          String?           @map("inspection_note")
  inspectedAt             DateTime?         @map("inspected_at") @db.Timestamptz(3)
  resolution              ClaimResolution?
  replacementSerialUnitId String?           @map("replacement_serial_unit_id") @db.Uuid
  replacementWarrantyId   String?           @unique @map("replacement_warranty_id") @db.Uuid
  resolutionNote          String?           @map("resolution_note")
  resolvedAt              DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdById             String?           @map("created_by_id") @db.Uuid
  version                 Int               @default(1)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  warranty              Warranty           @relation("ClaimWarranty", fields: [warrantyId], references: [id], onDelete: Restrict)
  serialUnit            SerialUnit         @relation("ClaimSerial", fields: [serialUnitId], references: [id], onDelete: Restrict)
  customer              Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receivedLocation      Location           @relation(fields: [receivedLocationId], references: [id], onDelete: Restrict)
  replacementSerialUnit SerialUnit?        @relation("ClaimReplacementSerial", fields: [replacementSerialUnitId], references: [id], onDelete: Restrict)
  replacementWarranty   Warranty?          @relation("ClaimReplacementWarranty", fields: [replacementWarrantyId], references: [id], onDelete: Restrict)
  createdBy             Staff?             @relation("WarrantyClaimCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  serviceJobs           ServiceJob[]
  vendorReturnItems     VendorReturnItem[]

  @@index([warrantyId])
  @@index([serialUnitId])
  @@index([status, receivedAt])
  @@index([contactPhone])
  @@map("warranty_claims")
}

/// Phiếu gửi máy lỗi về nhà cung cấp
model VendorReturn {
  id             String             @id @default(uuid(7)) @db.Uuid
  code           String             @unique @db.VarChar(30)
  supplierId     String             @map("supplier_id") @db.Uuid
  fromLocationId String             @map("from_location_id") @db.Uuid
  status         VendorReturnStatus @default(DRAFT)
  trackingCode   String?            @map("tracking_code") @db.VarChar(60)
  note           String?
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(3)
  completedAt    DateTime?          @map("completed_at") @db.Timestamptz(3)
  cancelledAt    DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  fromLocation Location           @relation(fields: [fromLocationId], references: [id], onDelete: Restrict)
  createdBy    Staff?             @relation("VendorReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items        VendorReturnItem[]

  @@index([status, sentAt])
  @@map("vendor_returns")
}

model VendorReturnItem {
  id                      String              @id @default(uuid(7)) @db.Uuid
  vendorReturnId          String              @map("vendor_return_id") @db.Uuid
  serialUnitId            String              @map("serial_unit_id") @db.Uuid
  warrantyClaimId         String?             @map("warranty_claim_id") @db.Uuid
  outcome                 VendorReturnOutcome @default(PENDING)
  replacementSerialUnitId String?             @map("replacement_serial_unit_id") @db.Uuid
  /// Số tiền hãng hoàn (khi REFUNDED)
  refundAmount            BigInt?             @map("refund_amount")
  resolvedAt              DateTime?           @map("resolved_at") @db.Timestamptz(3)
  note                    String?

  vendorReturn          VendorReturn   @relation(fields: [vendorReturnId], references: [id], onDelete: Cascade)
  serialUnit            SerialUnit     @relation("VendorReturnSerial", fields: [serialUnitId], references: [id], onDelete: Restrict)
  warrantyClaim         WarrantyClaim? @relation(fields: [warrantyClaimId], references: [id], onDelete: Restrict)
  replacementSerialUnit SerialUnit?    @relation("VendorReturnReplacementSerial", fields: [replacementSerialUnitId], references: [id], onDelete: Restrict)

  @@unique([vendorReturnId, serialUnitId])
  @@index([serialUnitId])
  @@index([warrantyClaimId])
  @@map("vendor_return_items")
}

// ============================================================
// NHÓM 3.8: NỘI DUNG, ĐÁNH GIÁ, CẤU HÌNH, THÔNG BÁO, OUTBOX, NHẬT KÝ
// content_html phải được LỌC SẠCH trên server trước khi lưu (chống XSS).
// Đánh giá chỉ từ dòng đơn của đơn COMPLETED, qua link có mã (lưu mã băm).
// products.rating_count/rating_sum do trigger tính từ đánh giá APPROVED.
// url_redirects luôn "phẳng": không cho A -> B -> C (trigger).
// audit_logs và policy_versions bất biến. system_settings được seed trong migration.
// CHECK, trigger và seed nằm trong migration *_platform.
// ============================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

enum BannerPlacement {
  HOME_HERO
  HOME_SECONDARY
  CATEGORY_TOP
  POPUP

  @@map("banner_placement")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

enum MessageChannel {
  EMAIL
  ZALO_ZNS

  @@map("message_channel")
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED

  @@map("message_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED

  @@map("outbox_status")
