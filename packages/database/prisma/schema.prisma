// ---------- Nội dung ----------

/// Tệp ảnh, video trên Cloudflare R2
model MediaAsset {
  id             String   @id @default(uuid(7)) @db.Uuid
  storageKey     String   @unique @map("storage_key") @db.VarChar(500)
  url            String
  mimeType       String   @map("mime_type") @db.VarChar(100)
  sizeBytes      Int      @map("size_bytes")
  width          Int?
  height         Int?
  altText        String?  @map("alt_text") @db.VarChar(200)
  /// SHA-256 (hex) của nội dung tệp, để phát hiện tệp trùng
  checksumSha256 String?  @map("checksum_sha256") @db.Char(64)
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  uploadedBy    Staff?   @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  postCovers    Post[]
  bannerDesktop Banner[] @relation("BannerDesktopMedia")
  bannerMobile  Banner[] @relation("BannerMobileMedia")

  @@index([checksumSha256])
  @@map("media_assets")
}

model PostCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(120)
  name      String   @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  posts Post[]

  @@map("post_categories")
}

/// Bài viết, tin tức, hướng dẫn
model Post {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String        @unique @db.VarChar(160)
  title          String        @db.VarChar(255)
  excerpt        String?
  /// Dữ liệu gốc của trình soạn thảo
  contentJson    Json          @default("{}") @map("content_json")
  /// HTML đã lọc sạch để hiển thị
  contentHtml    String        @default("") @map("content_html")
  coverMediaId   String?       @map("cover_media_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(3)
  authorId       String?       @map("author_id") @db.Uuid
  seoTitle       String?       @map("seo_title") @db.VarChar(200)
  seoDescription String?       @map("seo_description") @db.VarChar(320)
  viewCount      Int           @default(0) @map("view_count")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  coverMedia MediaAsset?   @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author     Staff?        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  products   PostProduct[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

/// Sản phẩm được nhắc tới trong bài viết
model PostProduct {
  postId    String @map("post_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
  @@map("post_products")
}

/// Trang tĩnh: giới thiệu, liên hệ...
model Page {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String        @unique @db.VarChar(160)
  title          String        @db.VarChar(255)
  contentJson    Json          @default("{}") @map("content_json")
  contentHtml    String        @default("") @map("content_html")
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(3)
  seoTitle       String?       @map("seo_title") @db.VarChar(200)
  seoDescription String?       @map("seo_description") @db.VarChar(320)
  updatedById    String?       @map("updated_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy Staff? @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("pages")
}

/// Phiên bản chính sách (bất biến): PRIVACY, WARRANTY, RETURN, TERMS...
model PolicyVersion {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @db.VarChar(40)
  version     String   @db.VarChar(20)
  title       String   @db.VarChar(255)
  contentHtml String   @map("content_html")
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy Staff? @relation("PolicyVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([code, version])
  @@index([code, effectiveAt])
  @@map("policy_versions")
}

model Banner {
  id             String          @id @default(uuid(7)) @db.Uuid
  title          String          @db.VarChar(200)
  placement      BannerPlacement
  desktopMediaId String          @map("desktop_media_id") @db.Uuid
  mobileMediaId  String?         @map("mobile_media_id") @db.Uuid
  linkUrl        String?         @map("link_url") @db.VarChar(500)
  altText        String?         @map("alt_text") @db.VarChar(200)
  startsAt       DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?       @map("ends_at") @db.Timestamptz(3)
  sortOrder      Int             @default(0) @map("sort_order")
  isActive       Boolean         @default(true) @map("is_active")
  /// Chỉ dùng với CATEGORY_TOP: hiện ở trang danh mục này; null = mọi danh mục (CHECK banners_category_placement)
  categoryId     String?         @map("category_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  desktopMedia MediaAsset  @relation("BannerDesktopMedia", fields: [desktopMediaId], references: [id], onDelete: Restrict)
  mobileMedia  MediaAsset? @relation("BannerMobileMedia", fields: [mobileMediaId], references: [id], onDelete: SetNull)
  /// Xóa danh mục thì xóa luôn banner riêng của nó (không để banner rơi thành "mọi danh mục")
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([placement, isActive, sortOrder])
  @@index([categoryId])
  @@map("banners")
}

model Faq {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Nhóm câu hỏi, vd: MUA_HANG, LAP_DAT, BAO_HANH
  groupCode   String   @map("group_code") @db.VarChar(40)
  question    String   @db.VarChar(500)
  answerHtml  String   @map("answer_html")
  /// Gắn vào một sản phẩm; null = câu hỏi chung
  productId   String?  @map("product_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([groupCode, sortOrder])
  @@index([productId])
  @@map("faqs")
}

/// Chuyển hướng URL (luôn phẳng, không nối chuỗi)
model UrlRedirect {
  id          String    @id @default(uuid(7)) @db.Uuid
  fromPath    String    @unique @map("from_path") @db.VarChar(500)
  toPath      String    @map("to_path") @db.VarChar(500)
  statusCode  Int       @default(301) @map("status_code")
  hitCount    Int       @default(0) @map("hit_count")
  lastHitAt   DateTime? @map("last_hit_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy Staff? @relation("RedirectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([toPath])
  @@map("url_redirects")
}

// ---------- Đánh giá ----------

/// Đánh giá sản phẩm của khách đã mua (mỗi dòng đơn tối đa một đánh giá)
/// Đánh giá sản phẩm. Khách viết thẳng trên trang sản phẩm (Bước 8), mọi đánh giá chờ duyệt.
/// order_line_id có khi số điện thoại khớp một đơn Hoàn tất có sản phẩm này ("Đã mua hàng").
model ProductReview {
  id               String       @id @default(uuid(7)) @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  orderLineId      String?      @unique @map("order_line_id") @db.Uuid
  customerId       String?      @map("customer_id") @db.Uuid
  reviewerName     String       @map("reviewer_name") @db.VarChar(100)
  /// Dạng +84xxxxxxxxx. Không hiện công khai; mỗi số một đánh giá (chưa bị từ chối) cho mỗi sản phẩm
  reviewerPhone    String       @map("reviewer_phone") @db.VarChar(16)
  /// Số điện thoại khớp đơn Hoàn tất có sản phẩm này
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  rating           Int
  content          String?
  photos           Json         @default("[]")
  status           ReviewStatus @default(PENDING)
  moderatedById    String?      @map("moderated_by_id") @db.Uuid
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz(3)
  rejectReason     String?      @map("reject_reason")
  replyContent     String?      @map("reply_content")
  repliedAt        DateTime?    @map("replied_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  moderatedBy Staff?     @relation("ReviewModeratedBy", fields: [moderatedById], references: [id], onDelete: Restrict)

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([productId, reviewerPhone])
  @@map("product_reviews")
}

/// Link mời đánh giá gửi cho khách (chỉ lưu mã băm)
model ReviewRequest {
  id          String    @id @default(uuid(7)) @db.Uuid
  orderLineId String    @map("order_line_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([orderLineId])
  @@map("review_requests")
}

// ---------- Cấu hình ----------

/// Cấu hình hệ thống dạng khóa-giá trị; API kiểm tra giá trị bằng Zod
model SystemSetting {
  key         String   @id @db.VarChar(80)
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy Staff? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

// ---------- Thông báo ----------

model StaffNotification {
  id        String    @id @default(uuid(7)) @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  /// vd: ORDER_CREATED, QUOTE_NEEDS_APPROVAL, STOCK_LOW
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(200)
  body      String?
  link      String?   @db.VarChar(500)
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, readAt, createdAt])
  @@map("staff_notifications")
}

/// Mẫu tin gửi khách
model MessageTemplate {
  id                 String         @id @default(uuid(7)) @db.Uuid
  channel            MessageChannel
  /// Mã nghiệp vụ, vd: ORDER_CONFIRMED
  code               String         @db.VarChar(60)
  name               String         @db.VarChar(200)
  /// Mã mẫu do Zalo cấp sau khi duyệt
  providerTemplateId String?        @map("provider_template_id") @db.VarChar(60)
  subject            String?        @db.VarChar(200)
  body               String
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([channel, code])
  @@map("message_templates")
}

/// Mỗi tin đã hoặc sẽ gửi cho khách
model OutboundMessage {
  id                String         @id @default(uuid(7)) @db.Uuid
  channel           MessageChannel
  templateCode      String         @map("template_code") @db.VarChar(60)
  /// Email (viết thường) hoặc số điện thoại +84
  recipient         String         @db.VarChar(200)
  customerId        String?        @map("customer_id") @db.Uuid
  orderId           String?        @map("order_id") @db.Uuid
  payload           Json
  status            MessageStatus  @default(QUEUED)
  /// Chống gửi trùng, vd: ORDER_CONFIRMED:<order_id>:ZALO_ZNS
  idempotencyKey    String         @unique @map("idempotency_key") @db.VarChar(200)
  providerMessageId String?        @map("provider_message_id") @db.VarChar(100)
  attempts          Int            @default(0)
  lastError         String?        @map("last_error")
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([customerId])
  @@index([orderId])
  @@map("outbound_messages")
}

// ---------- Hạ tầng ----------

/// Transactional outbox: ghi cùng transaction với nghiệp vụ, worker xử lý sau
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  /// vd: ORDER, QUOTE, WARRANTY
  aggregateType String       @map("aggregate_type") @db.VarChar(40)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  /// vd: order.confirmed, quote.pdf_requested
  eventType     String       @map("event_type") @db.VarChar(80)
  payload       Json         @default("{}")
  /// Chống ghi trùng cùng một sự kiện
  dedupeKey     String?      @unique @map("dedupe_key") @db.VarChar(200)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Nhật ký thao tác (bất biến)
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  staffId    String?  @map("staff_id") @db.Uuid
  /// vd: order.cancel, setting.update, staff.disable
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.Uuid
  /// { "before": {...}, "after": {...} } (không chứa mật khẩu, token)
  changes    Json     @default("{}")
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  traceId    String?  @map("trace_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([staffId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============================================================
// NHÓM 3.6: BÁO GIÁ CÔNG TRÌNH
// Một báo giá -> một đơn (orders.quote_id duy nhất, kênh PROJECT). Không mua nợ.
// Sửa sau khi gửi = tạo phiên bản mới cùng mã; bản cũ chuyển SUPERSEDED.
// Dòng báo giá chỉ sửa được khi báo giá còn DRAFT (trigger).
// Báo giá không giữ hàng; giữ hàng khi chuyển thành đơn.
// CHECK, unique có điều kiện và trigger viết tay nằm trong migration *_quotes.
// Tạo phiên bản mới: chuyển bản cũ sang SUPERSEDED TRƯỚC, rồi mới thêm bản mới (unique quotes_one_current_revision).
// ============================================================

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  SUPERSEDED
  CANCELLED

  @@map("quote_status")
}

enum QuoteSendChannel {
  ZALO
  EMAIL
  OTHER

  @@map("quote_send_channel")
}

model Quote {
  id                 String      @id @default(uuid(7)) @db.Uuid
  /// Mã dùng chung cho mọi phiên bản, vd: BG-260917-0001
  code               String      @db.VarChar(30)
  revision           Int         @default(1)
  previousRevisionId String?     @unique @map("previous_revision_id") @db.Uuid
  status             QuoteStatus @default(DRAFT)
  customerId         String      @map("customer_id") @db.Uuid
  contactId          String?     @map("contact_id") @db.Uuid
  projectName        String?     @map("project_name") @db.VarChar(255)
  siteAddress        String?     @map("site_address")
  siteRegion         Region?     @map("site_region")
  validUntil         DateTime    @map("valid_until") @db.Date

  // Tiền (VND), giá dòng CHƯA VAT
  vatInvoiceRequested Boolean @default(true) @map("vat_invoice_requested")
  /// Tổng theo giá hệ thống tính (để thể hiện mức tiết kiệm)
  referenceSubtotal   BigInt  @default(0) @map("reference_subtotal")
  subtotal            BigInt  @default(0)
  shippingFee         BigInt  @default(0) @map("shipping_fee")
  vatTotal            BigInt  @default(0) @map("vat_total")
  grandTotal          BigInt  @default(0) @map("grand_total")
  depositRequired     BigInt  @default(0) @map("deposit_required")

  // Duyệt chiết khấu
  /// Mức giảm lớn nhất trên các dòng so với giá hệ thống (phần vạn)
  maxDiscountBps   Int       @default(0) @map("max_discount_bps")
  requiresApproval Boolean   @default(false) @map("requires_approval")
  approvedById     String?   @map("approved_by_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(3)
  approvalNote     String?   @map("approval_note")

  // Gửi khách
  pdfUrl         String?           @map("pdf_url")
  pdfGeneratedAt DateTime?         @map("pdf_generated_at") @db.Timestamptz(3)
  sentAt         DateTime?         @map("sent_at") @db.Timestamptz(3)
  sentVia        QuoteSendChannel? @map("sent_via")
  sentById       String?           @map("sent_by_id") @db.Uuid

  /// Điều khoản in trên báo giá (thời gian giao, bảo hành, thanh toán...)
  terms          String?
  internalNote   String?   @map("internal_note")
  rejectedReason String?   @map("rejected_reason")
  createdById    String?   @map("created_by_id") @db.Uuid
  version        Int       @default(1)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  convertedAt    DateTime? @map("converted_at") @db.Timestamptz(3)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact          CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  previousRevision Quote?           @relation("QuoteRevisions", fields: [previousRevisionId], references: [id], onDelete: Restrict)
  nextRevision     Quote?           @relation("QuoteRevisions")
  approvedBy       Staff?           @relation("QuoteApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  sentBy           Staff?           @relation("QuoteSentBy", fields: [sentById], references: [id], onDelete: Restrict)
  createdBy        Staff?           @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines            QuoteLine[]
  order            Order?

  @@unique([code, revision])
  @@index([customerId])
  @@index([status, validUntil])
  @@map("quotes")
}

model QuoteLine {
  id                  String        @id @default(uuid(7)) @db.Uuid
  quoteId             String        @map("quote_id") @db.Uuid
  /// Dòng khóa mà dòng lắp đặt gắn vào
  parentLineId        String?       @map("parent_line_id") @db.Uuid
  /// Chỉ PRODUCT, BUNDLE, INSTALLATION
  lineType            OrderLineType @map("line_type")
  variantId           String?       @map("variant_id") @db.Uuid
  sku                 String?       @db.VarChar(64)
  name                String        @db.VarChar(255)
  quantity            Int
  /// Giá hệ thống tính tại lúc lập báo giá (chưa VAT)
  referencePrice      BigInt        @map("reference_price")
  /// Giá báo cho khách (chưa VAT)
  unitPrice           BigInt        @map("unit_price")
  /// (reference - unit) / reference, phần vạn; âm nếu báo cao hơn giá hệ thống
  discountBps         Int           @map("discount_bps")
  lineTotal           BigInt        @map("line_total")
  vatRateBps          Int           @map("vat_rate_bps")
  vatAmount           BigInt        @default(0) @map("vat_amount")
  installationClassId String?       @map("installation_class_id") @db.Uuid
  installationRegion  Region?       @map("installation_region")
  note                String?
  sortOrder           Int           @default(0) @map("sort_order")

  quote             Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  parentLine        QuoteLine?         @relation("QuoteLineTree", fields: [parentLineId], references: [id], onDelete: Cascade)
  childLines        QuoteLine[]        @relation("QuoteLineTree")
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  installationClass InstallationClass? @relation(fields: [installationClassId], references: [id], onDelete: Restrict)
  orderLines        OrderLine[]

  @@index([quoteId, sortOrder])
  @@index([variantId])
  @@map("quote_lines")
}
