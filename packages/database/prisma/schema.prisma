// Prisma ORM 7. Quy ước đặt tên:
// - Trong code: PascalCase (model), camelCase (field)
// - Trong PostgreSQL: snake_case, dùng @@map và @map

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Giá trị enum phải khớp với LocationType và Region trong @ktm/shared
enum LocationType {
  WAREHOUSE
  STORE

  @@map("location_type")
}

enum Region {
  HCM
  HN

  @@map("region")
}

/// Điểm tồn kho: kho tổng TP.HCM và các cửa hàng
model Location {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique @db.VarChar(32)
  name      String       @db.VarChar(255)
  type      LocationType
  region    Region
  address   String
  phone     String?      @db.VarChar(20)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  stockLevels   StockLevel[]
  serialUnits   SerialUnit[]
  goodsReceipts GoodsReceipt[]
  transfersOut  StockTransfer[] @relation("TransferFrom")
  transfersIn   StockTransfer[] @relation("TransferTo")
  stocktakes    Stocktake[]

  @@map("locations")
}

// ============================================================
// NHÓM 3.1: DANH MỤC SẢN PHẨM
// Tiền: BigInt (VND). Sản phẩm không bị xóa, chỉ chuyển ARCHIVED.
// Ràng buộc CHECK viết tay nằm trong migration *_catalog (slug, SKU, giá, combo...).
// Prisma không quản lý CHECK: khi thêm ràng buộc mới, tạo migration --create-only rồi viết SQL.
// ============================================================

enum ProductType {
  LOCK
  ACCESSORY
  SERVICE
  BUNDLE

  @@map("product_type")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum SpecDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT

  @@map("spec_data_type")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum ProductRelationType {
  ACCESSORY
  SIMILAR
  UPSELL

  @@map("product_relation_type")
}

/// Hãng khóa
model Brand {
  id                     String    @id @default(uuid(7)) @db.Uuid
  slug                   String    @unique @db.VarChar(120)
  name                   String    @db.VarChar(120)
  logoUrl                String?   @map("logo_url")
  description            String?
  countryOfOrigin        String?   @map("country_of_origin") @db.VarChar(80)
  /// Công ty có giấy ủy quyền phân phối chính hãng
  isAuthorized           Boolean   @default(false) @map("is_authorized")
  authorizationDocUrl    String?   @map("authorization_doc_url")
  authorizationExpiresAt DateTime? @map("authorization_expires_at") @db.Date
  isActive               Boolean   @default(true) @map("is_active")
  sortOrder              Int       @default(0) @map("sort_order")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

/// Danh mục dạng cây
model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  specDefinitions SpecDefinition[]

  @@index([parentId])
  @@map("categories")
}

/// Khuôn thông số kỹ thuật theo danh mục: kiểm tra dữ liệu và sinh bộ lọc
model SpecDefinition {
  id           String       @id @default(uuid(7)) @db.Uuid
  categoryId   String       @map("category_id") @db.Uuid
  /// Khóa trong products.specs, vd: unlock_methods
  code         String       @db.VarChar(64)
  name         String       @db.VarChar(120)
  dataType     SpecDataType @map("data_type")
  unit         String?      @db.VarChar(20)
  /// Giá trị cho SELECT/MULTI_SELECT: [{ "value": "fingerprint", "label": "Vân tay" }]
  options      Json?
  isFilterable Boolean      @default(false) @map("is_filterable")
  isRequired   Boolean      @default(false) @map("is_required")
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, code])
  @@map("spec_definitions")
}

/// Nhóm tính giá lắp đặt theo loại khóa/cửa
model InstallationClass {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rates    InstallationRate[]
  products Product[]

  @@map("installation_classes")
}

/// Giá lắp đặt theo (nhóm lắp đặt, khu vực)
model InstallationRate {
  installationClassId String   @map("installation_class_id") @db.Uuid
  region              Region
  price               BigInt
  isActive            Boolean  @default(true) @map("is_active")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  installationClass InstallationClass @relation(fields: [installationClassId], references: [id], onDelete: Cascade)

  @@id([installationClassId, region])
  @@map("installation_rates")
}

/// Mẫu sản phẩm (khóa, phụ kiện, dịch vụ, combo)
model Product {
  id                  String        @id @default(uuid(7)) @db.Uuid
  type                ProductType
  status              ProductStatus @default(DRAFT)
  /// Dịch vụ không có hãng
  brandId             String?       @map("brand_id") @db.Uuid
  categoryId          String        @map("category_id") @db.Uuid
  /// Chỉ khóa mới có; null = không nhận lắp đặt
  installationClassId String?       @map("installation_class_id") @db.Uuid
  slug                String        @unique @db.VarChar(160)
  name                String        @db.VarChar(200)
  /// Mã model của hãng (có thể trùng giữa các hãng)
  manufacturerCode    String?       @map("manufacturer_code") @db.VarChar(80)
  shortDescription    String?       @map("short_description")
  description         String?
  /// Giá trị thông số, khóa theo spec_definitions.code
  specs               Json          @default("{}")
  warrantyMonths      Int           @default(0) @map("warranty_months")
  seoTitle            String?       @map("seo_title") @db.VarChar(200)
  seoDescription      String?       @map("seo_description") @db.VarChar(320)
  publishedAt         DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installationClass InstallationClass? @relation(fields: [installationClassId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  options           ProductOption[]
  media             ProductMedia[]
  relations         ProductRelation[]  @relation("RelationSource")
  relatedFrom       ProductRelation[]  @relation("RelationTarget")

  @@index([brandId])
  @@index([categoryId])
  @@index([type, status])
  @@index([specs(ops: JsonbPathOps)], type: Gin)
  @@map("products")
}

/// Trục lựa chọn của sản phẩm (Màu, Phiên bản)
model ProductOption {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  code      String @db.VarChar(60)
  name      String @db.VarChar(60)
  sortOrder Int    @default(0) @map("sort_order")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, code])
  @@map("product_options")
}

/// Giá trị của một trục lựa chọn (Đen, Vàng đồng)
model ProductOptionValue {
  id        String @id @default(uuid(7)) @db.Uuid
  optionId  String @map("option_id") @db.Uuid
  code      String @db.VarChar(60)
  value     String @db.VarChar(60)
  sortOrder Int    @default(0) @map("sort_order")

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, code])
  @@map("product_option_values")
}

/// Biến thể: mặt hàng bán được thật (SKU, giá, serial)
model ProductVariant {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  /// SKU nội bộ do công ty đặt, duy nhất toàn hệ thống
  sku            String   @unique @db.VarChar(64)
  name           String   @db.VarChar(200)
  /// Tổ hợp lựa chọn đã sắp xếp, vd: "mau:den|phien-ban:wifi". Rỗng nếu sản phẩm không có lựa chọn.
  optionKey      String   @default("") @map("option_key") @db.VarChar(255)
  /// Giá bán lẻ niêm yết (VND)
  price          BigInt
  /// Giá gạch ngang để hiển thị (VND)
  compareAtPrice BigInt?  @map("compare_at_price")
  barcode        String?  @db.VarChar(64)
  weightGrams    Int?     @map("weight_grams")
  trackSerial    Boolean  @default(false) @map("track_serial")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  optionValues  VariantOptionValue[]
  media         ProductMedia[]
  bundleItems   BundleItem[]         @relation("BundleParent")
  usedInBundles BundleItem[]         @relation("BundleComponent")

  stockLevels    StockLevel[]
  serialUnits    SerialUnit[]
  receiptLines   GoodsReceiptLine[]
  transferLines  StockTransferLine[]
  stocktakeLines StocktakeLine[]

  @@unique([productId, optionKey])
  @@map("product_variants")
}

/// Biến thể nào ứng với giá trị lựa chọn nào
model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

/// Ảnh và video sản phẩm; variant_id có giá trị nếu ảnh chỉ dành cho một biến thể
model ProductMedia {
  id        String    @id @default(uuid(7)) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  variantId String?   @map("variant_id") @db.Uuid
  type      MediaType @default(IMAGE)
  url       String
  altText   String?   @map("alt_text") @db.VarChar(200)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_media")
}

/// Thành phần của combo
model BundleItem {
  bundleVariantId    String @map("bundle_variant_id") @db.Uuid
  componentVariantId String @map("component_variant_id") @db.Uuid
  quantity           Int    @default(1)

  bundleVariant    ProductVariant @relation("BundleParent", fields: [bundleVariantId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("BundleComponent", fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@id([bundleVariantId, componentVariantId])
  @@index([componentVariantId])
  @@map("bundle_items")
}

/// Sản phẩm liên quan: phụ kiện tương thích, sản phẩm tương tự, gợi ý nâng cấp
model ProductRelation {
  productId        String              @map("product_id") @db.Uuid
  relatedProductId String              @map("related_product_id") @db.Uuid
  type             ProductRelationType
  sortOrder        Int                 @default(0) @map("sort_order")

  product        Product @relation("RelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId, type])
  @@index([relatedProductId])
  @@map("product_relations")
}

// ============================================================
// NHÓM 3.2: TỒN KHO
// on_hand chỉ gồm hàng MỚI bán được; hàng trưng bày và hàng lỗi không tính.
// Mọi thay đổi on_hand phải ghi stock_movements trong CÙNG transaction.
// CHECK và trigger viết tay nằm trong migration *_inventory.
// stock_movements có trigger chặn UPDATE/DELETE/TRUNCATE: sửa sai bằng cách ghi thêm dòng ADJUSTMENT.
// ============================================================

enum SerialUnitStatus {
  IN_STOCK
  DISPLAY
  IN_TRANSIT
  SOLD
  DEFECTIVE
  AT_VENDOR
  SCRAPPED

  @@map("serial_unit_status")
}

enum ReservationSource {
  /// Giữ tạm trong lúc thanh toán online, có hạn
  ONLINE_CHECKOUT
  /// Giữ theo đơn (COD, chuyển khoản, đặt cọc showroom), không hạn
  ORDER

  @@map("reservation_source")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum StockMovementType {
  RECEIPT
  SALE
  SALE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  TO_DISPLAY
  FROM_DISPLAY
  DISPLAY_SALE
  MARK_DEFECTIVE
  SEND_TO_VENDOR
  RECEIVE_FROM_VENDOR
  SCRAP

  @@map("stock_movement_type")
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED

  @@map("document_status")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED

  @@map("transfer_status")
}

/// Tồn kho hàng mới theo (biến thể, showroom). Bán được = on_hand - reserved.
model StockLevel {
  variantId  String   @map("variant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  onHand     Int      @default(0) @map("on_hand")
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant      ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reservations StockReservation[]
  movements    StockMovement[]

  @@id([variantId, locationId])
  @@index([locationId])
  @@map("stock_levels")
}

/// Từng chiếc có serial
model SerialUnit {
  id            String           @id @default(uuid(7)) @db.Uuid
  variantId     String           @map("variant_id") @db.Uuid
  /// Viết hoa, không khoảng trắng đầu/cuối
  serialNumber  String           @map("serial_number") @db.VarChar(100)
  status        SerialUnitStatus @default(IN_STOCK)
  /// Null khi chiếc không nằm ở showroom nào (đã bán, đang chuyển, ở hãng...)
  locationId    String?          @map("location_id") @db.Uuid
  /// Giá bán hàng trưng bày (VND)
  displayPrice  BigInt?          @map("display_price")
  /// Đang rao bán hàng trưng bày trên website
  isListed      Boolean          @default(false) @map("is_listed")
  conditionNote String?          @map("condition_note")
  /// Ảnh thực tế của máy trưng bày: ["url1", "url2"]
  displayPhotos Json             @default("[]") @map("display_photos")
  receivedAt    DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  soldAt        DateTime?        @map("sold_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location  Location?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([variantId, serialNumber])
  @@index([serialNumber])
  @@index([locationId, status])
  @@map("serial_units")
}

/// Lượt giữ hàng
model StockReservation {
  id         String            @id @default(uuid(7)) @db.Uuid
  variantId  String            @map("variant_id") @db.Uuid
  locationId String            @map("location_id") @db.Uuid
  quantity   Int
  source     ReservationSource
  status     ReservationStatus @default(ACTIVE)
  /// FK tới đơn hàng, sẽ thêm ở nhóm 3.5
  orderId    String?           @map("order_id") @db.Uuid
  /// Bắt buộc với ONLINE_CHECKOUT, null với ORDER
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  stockLevel StockLevel @relation(fields: [variantId, locationId], references: [variantId, locationId], onDelete: Restrict)

  @@index([variantId, locationId])
  @@index([orderId])
  @@map("stock_reservations")
}

/// Sổ kho bất biến: KHÔNG sửa, KHÔNG xóa (có trigger chặn)
model StockMovement {
  id            String            @id @default(uuid(7)) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  type          StockMovementType
  /// Thay đổi on_hand (+/-). Bằng 0 khi chỉ đổi trạng thái serial.
  quantityDelta Int               @map("quantity_delta")
  onHandAfter   Int               @map("on_hand_after")
  serialUnitId  String?           @map("serial_unit_id") @db.Uuid
  /// Loại chứng từ gốc: GOODS_RECEIPT, STOCK_TRANSFER, STOCKTAKE, ORDER...
  documentType  String?           @map("document_type") @db.VarChar(40)
  documentId    String?           @map("document_id") @db.Uuid
  note          String?
  /// FK tới nhân viên, sẽ thêm ở nhóm 3.3
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  stockLevel StockLevel  @relation(fields: [variantId, locationId], references: [variantId, locationId], onDelete: Restrict)
  serialUnit SerialUnit? @relation(fields: [serialUnitId], references: [id], onDelete: Restrict)

  @@index([variantId, locationId, createdAt])
  @@index([documentType, documentId])
  @@index([serialUnitId])
  @@map("stock_movements")
}

/// Nhà cung cấp (hãng hoặc nhà phân phối)
model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(200)
  note      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  goodsReceipts GoodsReceipt[]

  @@map("suppliers")
}

/// Phiếu nhập hàng
model GoodsReceipt {
  id          String         @id @default(uuid(7)) @db.Uuid
  code        String         @unique @db.VarChar(30)
  locationId  String         @map("location_id") @db.Uuid
  supplierId  String?        @map("supplier_id") @db.Uuid
  status      DocumentStatus @default(DRAFT)
  note        String?
  postedAt    DateTime?      @map("posted_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplier Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    GoodsReceiptLine[]

  @@index([locationId, status])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id            String   @id @default(uuid(7)) @db.Uuid
  receiptId     String   @map("receipt_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  /// Serial quét khi nhập; số phần tử phải bằng quantity nếu biến thể quản lý serial
  serialNumbers String[] @default([]) @map("serial_numbers")

  receipt GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([receiptId, variantId])
  @@map("goods_receipt_lines")
}

/// Phiếu chuyển hàng giữa showroom
model StockTransfer {
  id             String         @id @default(uuid(7)) @db.Uuid
  code           String         @unique @db.VarChar(30)
  fromLocationId String         @map("from_location_id") @db.Uuid
  toLocationId   String         @map("to_location_id") @db.Uuid
  status         TransferStatus @default(DRAFT)
  note           String?
  shippedAt      DateTime?      @map("shipped_at") @db.Timestamptz(3)
  receivedAt     DateTime?      @map("received_at") @db.Timestamptz(3)
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  fromLocation Location            @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location            @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines        StockTransferLine[]

  @@index([status, shippedAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id            String   @id @default(uuid(7)) @db.Uuid
  transferId    String   @map("transfer_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  serialNumbers String[] @default([]) @map("serial_numbers")

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, variantId])
  @@map("stock_transfer_lines")
}

/// Phiếu kiểm kê
model Stocktake {
  id          String         @id @default(uuid(7)) @db.Uuid
  code        String         @unique @db.VarChar(30)
  locationId  String         @map("location_id") @db.Uuid
  status      DocumentStatus @default(DRAFT)
  note        String?
  postedAt    DateTime?      @map("posted_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines    StocktakeLine[]

  @@index([locationId, status])
  @@map("stocktakes")
}

model StocktakeLine {
  id          String @id @default(uuid(7)) @db.Uuid
  stocktakeId String @map("stocktake_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  /// Số trên hệ thống tại thời điểm bắt đầu kiểm kê
  systemQty   Int    @map("system_qty")
  countedQty  Int    @map("counted_qty")

  stocktake Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stocktakeId, variantId])
  @@map("stocktake_lines")
}
