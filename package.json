{
  "name": "khoathongminh",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@ktm/api...",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "infra:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "prettier": "^3.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core",
      "msgpackr-extract"
    ],
    "overrides": {
      "deepmerge-ts": ">=8.0.0",
      "mysql2": ">=3.22.0",
      "uuid": ">=11.1.1"
    }
  }
}
