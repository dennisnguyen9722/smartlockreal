{
  "name": "@ktm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/main.js\"",
    "staff": "node --env-file=../../.env scripts/staff-cli.cjs"
  },
  "dependencies": {
    "@ktm/database": "workspace:*",
    "@ktm/shared": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/websockets": "^12.0.3",
    "@node-rs/argon2": "^2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.6",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.17.7",
    "sharp": "^0.35.4",
    "socket.io": "4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.5",
    "@types/sanitize-html": "2.16.1",
    "concurrently": "^10.0.5",
    "socket.io-client": "4.8.3",
    "typescript": "~5.9.3"
  }
}
